{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"**/*",
			"!components/ui",
			"!lib/utils.ts",
			"!hooks/use-mobile.ts",
			"!src/app/globals.css"
		]
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"linter": {
		"rules": {
			"suspicious": {
				/* Needs more work to fix */
				"noExplicitAny": "off",

				/* Allow for Tailwind @ rules */
				"noUnknownAtRules": "off",

				/* Allowing console for debugging */
				"noConsole": "off",

				/* Needed for generateUUID() */
				"noBitwiseOperators": "off",

				/* Allow array index keys for loading skeletons */
				"noArrayIndexKey": "off",

				/* Allow thenable mocks in tests */
				"noThenProperty": "off",

				/* Allow shadowing restricted names for Next.js conventions */
				"noShadowRestrictedNames": "off",

				/* Allow implicit any let */
				"noImplicitAnyLet": "off",

				/* Allow non-null assertions on optional chains */
				"noNonNullAssertedOptionalChain": "off"
			},
			"style": {
				/* Allowing magic numbers */
				"noMagicNumbers": "off",

				/* Needs more work to fix */
				"noNestedTernary": "off",

				/* Allow non-null assertions for concise code */
				"noNonNullAssertion": "off",

				/* Allow let declarations when const would be preferred */
				"useConst": "off"
			},
			"nursery": {
				/* Too many false positives */
				"noUnnecessaryConditions": "off"
			},
			"complexity": {
				/* Needs more work to fix */
				"noExcessiveCognitiveComplexity": "off",

				/* This one has false positives. It's a bit... iffy 😉 */
				"useSimplifiedLogicExpression": "off"
			},
			"a11y": {
				/* Needs more work to fix */
				"noSvgWithoutTitle": "off",

				/* Needs more work to fix - requires semantic refactoring */
				"useSemanticElements": "off",

				/* Needs more work to fix - requires keyboard event handlers */
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",

				/* Needs more work to fix - requires button type attributes */
				"useButtonType": "off"
			},
			"correctness": {
				/* Allow unused function parameters for API compatibility */
				"noUnusedFunctionParameters": "off",

				/* Allow unused variables that are intentionally destructured */
				"noUnusedVariables": "off",

				/* Hook order in conditionals is sometimes needed */
				"useHookAtTopLevel": "off",

				/* Allow use before declaration in useEffect deps */
				"noInvalidUseBeforeDeclaration": "off",

				/* Allow exhaustive dependencies to be flexible */
				"useExhaustiveDependencies": "off"
			}
		}
	}
}
