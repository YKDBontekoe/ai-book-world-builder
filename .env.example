# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on Vercel

# OpenRouter API Key
# Instructions to create an OpenRouter API key here: https://openrouter.ai/keys
OPENROUTER_API_KEY=


# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/postgres
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****

# Google OAuth Configuration
# Instructions: https://console.cloud.google.com/apis/credentials
# Create OAuth 2.0 Client ID and add authorized redirect URI:
# http://localhost:3000/api/auth/callback/google (for development)
# https://yourdomain.com/api/auth/callback/google (for production)
GOOGLE_CLIENT_ID=****
GOOGLE_CLIENT_SECRET=****

# Optional: URL to fetch external benchmarks from
BENCHMARK_API_URL=
