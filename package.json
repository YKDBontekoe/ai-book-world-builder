{
	"name": "ai-book-world-builder",
	"version": "3.1.0",
	"description": "AI-powered tool for authors to build worlds and generate books",
	"private": true,
	"engines": {
		"node": "^18.19.0 || >=20.6.0"
	},
	"scripts": {
		"dev": "next dev --turbo",
		"build": "next build",
		"start": "next start",
		"lint": "npx ultracite@latest check",
		"type-check": "tsc --noEmit",
		"format": "npx ultracite@latest fix",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "npx tsx src/lib/db/migrate.ts",
		"db:studio": "drizzle-kit studio",
		"db:push": "drizzle-kit push",
		"db:pull": "drizzle-kit pull",
		"db:check": "drizzle-kit check",
		"db:up": "drizzle-kit up",
		"test": "export PLAYWRIGHT=True && pnpm exec playwright test",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test:unit": "vitest run --project unit",
		"test:e2e": "export PLAYWRIGHT=True && playwright test",
		"test:visual": "python3 tests/verification/runner.py"
	},
	"lint-staged": {
		"**/*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
			"ultracite fix"
		]
	},
